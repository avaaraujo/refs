{
  "manifest_version": 3,
  "name": "Refs do Avá",
  "version": "1.0.0",
  "description": "Salva a página atual na sua biblioteca de referências (refs.avaaraujo.com).",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Adicionar aos Refs do Avá",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus"]
}
